# Only needed to preview the site locally: GitHub Pages builds it on its own.
# The github-pages gem can't install on Ruby 4 (its commonmarker needs Ruby < 4),
# so this pins the same Jekyll version GitHub Pages uses instead.
source "https://rubygems.org"

gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"
gem "webrick"
gem "csv"
gem "bigdecimal"
gem "base64"
gem "logger"
